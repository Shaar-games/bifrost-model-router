{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "/var/lib/bifrost/data/config.db" }
  },
  "logs_store": { "enabled": false },
  "client": {
    "allow_direct_keys": true,
    "disable_content_logging": true,
    "enable_logging": true,
    "enforce_auth_on_inference": true
  },
  "governance": {
    "auth_config": { "is_enabled": false },
    "virtual_keys": [{
      "id": "local-quickstart",
      "name": "Local Codex quickstart",
      "value": "env.BIFROST_QUICKSTART_VK",
      "is_active": true,
      "provider_configs": [{
        "provider": "openai",
        "allowed_models": ["regex:.*"],
        "blacklisted_models": [],
        "key_ids": ["*"]
      }]
    }]
  },
  "providers": {
    "openai": { "keys": [] }
  },
  "plugins": [{
    "enabled": true,
    "name": "governance",
    "config": { "is_vk_mandatory": true }
  }, {
    "enabled": true,
    "name": "codex-model-router",
    "path": "/lib/bifrost/plugins/codex-model-router.so",
    "config": {
      "version": 1,
      "hosted_tool_fallback_model": "openai/gpt-5.6-sol",
      "instructions_template": "You are a coding agent. Follow the user's instructions and use the available tools carefully.",
      "providers": {
        "openai": {
          "credential_mode": "request_passthrough",
          "responses_mode": "native",
          "adapter": "native",
          "discover_models": true
        }
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "aliases": ["gpt-5.6-sol"],
          "upstream_model": "gpt-5.6-sol",
          "codex": {
            "display_name": "GPT-5.6-Sol",
            "description": "OpenAI GPT-5.6-Sol through the local Bifrost router.",
            "context_window": 272000,
            "max_context_window": 872000,
            "effective_context_window_percent": 95,
            "default_reasoning_level": "medium",
            "supported_reasoning_levels": [
              { "effort": "low", "description": "Fast reasoning" },
              { "effort": "medium", "description": "Balanced reasoning" },
              { "effort": "high", "description": "Deep reasoning" }
            ],
            "input_modalities": ["text", "image"],
            "supports_reasoning_summaries": true,
            "supports_verbosity": true,
            "supports_image_detail_original": true
          }
        }
      }
    }
  }]
}
